<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="ExpenseTracker.Views.ExpensesListPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:vm="clr-namespace:ExpenseTracker.ViewModels"
             xmlns:models="clr-namespace:ExpenseTracker.Models"
             xmlns:converters="clr-namespace:ExpenseTracker.Converters"
             x:DataType="vm:ExpensesListViewModel"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="PrimaryPurple">#534AB7</Color>
            <Color x:Key="DangerRed">#E24B4A</Color>
            <Color x:Key="SuccessGreen">#1D9E75</Color>
        </ResourceDictionary>
        <ResourceDictionary>
            <converters:PillBgConverter     x:Key="PillBgConverter" />
            <converters:PillFontConverter   x:Key="PillFontConverter" />
            <converters:PillStrokeConverter x:Key="PillStrokeConverter"/>
            <converters:PillTextConverter   x:Key="PillTextConverter"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

        <!-- TOP BAR -->
        <Grid
            Grid.Row="0"
            Padding="16,52,16,12"
            ColumnDefinitions="*,Auto,Auto">
            <Label
                Grid.Column="0"
                FontAttributes="Bold"
                FontSize="22"
                Text="Expenses"
                TextColor="#1a1a2e"
                VerticalOptions="Center" />
            <Border
                Grid.Column="1"
                BackgroundColor="#F1EFF8"
                HeightRequest="36"
                Margin="0,0,8,0"
                StrokeShape="RoundRectangle 10"
                StrokeThickness="0"
                WidthRequest="36"
                VerticalOptions="Center">
                <Image HeightRequest="18" WidthRequest="18"
                       HorizontalOptions="Center" VerticalOptions="Center">
                    <Image.Behaviors>
                        <toolkit:IconTintColorBehavior TintColor="{StaticResource PrimaryPurple}" />
                    </Image.Behaviors>
                    <Image.Source>
                        <FontImageSource FontFamily="MaterialIcons" Glyph="&#xe8b6;" Color="#534AB7" Size="18" />
                    </Image.Source>
                </Image>
            </Border>
            <Border
                Grid.Column="2"
                BackgroundColor="#F1EFF8"
                HeightRequest="36"
                StrokeShape="RoundRectangle 10"
                StrokeThickness="0"
                WidthRequest="36"
                VerticalOptions="Center">
                <Image HeightRequest="18" WidthRequest="18"
                       HorizontalOptions="Center" VerticalOptions="Center">
                    <Image.Source>
                        <FontImageSource FontFamily="MaterialIcons" Glyph="&#xe896;" Color="#534AB7" Size="18" />
                    </Image.Source>
                </Image>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ExportCommand}" />
                </Border.GestureRecognizers>
            </Border>
        </Grid>

        <!-- SEARCH BAR -->
        <Border
            Grid.Row="1"
            BackgroundColor="#F5F5FA"
            Margin="16,0,16,10"
            Padding="12,0"
            StrokeShape="RoundRectangle 12"
            StrokeThickness="0"
            HeightRequest="44">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Image Grid.Column="0" HeightRequest="16" WidthRequest="16" VerticalOptions="Center" Margin="0,0,8,0">
                    <Image.Source>
                        <FontImageSource FontFamily="MaterialIcons" Glyph="&#xe8b6;" Color="#999" Size="16" />
                    </Image.Source>
                </Image>
                <Entry
                    Grid.Column="1"
                    BackgroundColor="Transparent"
                    FontSize="13"
                    Placeholder="Search expenses..."
                    PlaceholderColor="#aaa"
                    Text="{Binding SearchQuery}"
                    TextColor="#1a1a2e"
                    VerticalOptions="Center" />
                <Image Grid.Column="2" HeightRequest="16" WidthRequest="16" VerticalOptions="Center"
                       IsVisible="{Binding HasSearchQuery}">
                    <Image.Source>
                        <FontImageSource FontFamily="MaterialIcons" Glyph="&#xe5cd;" Color="#999" Size="16" />
                    </Image.Source>
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ClearSearchCommand}" />
                    </Image.GestureRecognizers>
                </Image>
            </Grid>
        </Border>

        <!-- CATEGORY FILTER PILLS -->
        <ScrollView Grid.Row="2" Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Margin="0,0,0,8">
            <HorizontalStackLayout Padding="16,0" Spacing="8">
                <BindableLayout.ItemsSource>
                    <Binding Path="CategoryFilters" />
                </BindableLayout.ItemsSource>
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:CategoryFilterItem">
                        <Border
                            Padding="14,7"
                            StrokeShape="RoundRectangle 20"
                            StrokeThickness="1"
                            BackgroundColor="{Binding IsSelected, Converter={StaticResource PillBgConverter}}"
                            Stroke="{Binding IsSelected, Converter={StaticResource PillStrokeConverter}}">
                            <Label
                                FontSize="12"
                                FontAttributes="{Binding IsSelected, Converter={StaticResource PillFontConverter}}"
                                Text="{Binding Name}"
                                TextColor="{Binding IsSelected, Converter={StaticResource PillTextConverter}}" />
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ExpensesListViewModel}}, Path=SelectFilterCommand}" CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </HorizontalStackLayout>
        </ScrollView>

        <!-- GROUPED TRANSACTION LIST -->
        <CollectionView
            Grid.Row="3"
            ItemsSource="{Binding GroupedExpenses}"
            IsGrouped="True"
            RemainingItemsThreshold="5"
            RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}">

            <!-- Group header -->
            <CollectionView.GroupHeaderTemplate>
                <DataTemplate x:DataType="models:ExpenseDayGroup">
                    <Grid ColumnDefinitions="*,Auto" Padding="16,12,16,4">
                        <Label
                            Grid.Column="0"
                            FontAttributes="Bold"
                            FontSize="12"
                            Text="{Binding DateLabel}"
                            TextColor="#888" />
                        <Label
                            Grid.Column="1"
                            FontAttributes="Bold"
                            FontSize="12"
                            Text="{Binding DayTotal, StringFormat='{0:C}'}"
                            TextColor="{StaticResource DangerRed}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>

            <!-- Transaction row -->
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:ExpenseDisplayItem">
                    <Grid
                        ColumnDefinitions="Auto,*,Auto"
                        ColumnSpacing="12"
                        Padding="16,8">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ExpensesListViewModel}}, Path=OpenExpenseCommand}" CommandParameter="{Binding .}" />
                        </Grid.GestureRecognizers>

                        <!-- Icon -->
                        <Border
                            Grid.Column="0"
                            BackgroundColor="{Binding IconBackground}"
                            HeightRequest="42"
                            StrokeShape="RoundRectangle 10"
                            StrokeThickness="0"
                            WidthRequest="42"
                            VerticalOptions="Center">
                            <Image HeightRequest="18" WidthRequest="18"
                                   HorizontalOptions="Center" VerticalOptions="Center">
                                <Image.Source>
                                    <FontImageSource FontFamily="MaterialIcons"
                                                     Glyph="{Binding IconGlyph}"
                                                     Color="{Binding IconColor}"
                                                     Size="18" />
                                </Image.Source>
                            </Image>
                        </Border>

                        <!-- Name + meta -->
                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                            <Label FontAttributes="Bold" FontSize="13" Text="{Binding Name}" TextColor="#1a1a2e" />
                            <HorizontalStackLayout Spacing="6">
                                <Border
                                    BackgroundColor="{Binding CategoryBackground}"
                                    Padding="6,2"
                                    StrokeShape="RoundRectangle 4"
                                    StrokeThickness="0">
                                    <Label FontSize="10" Text="{Binding CategoryName}" TextColor="{Binding CategoryColor}" />
                                </Border>
                                <Label FontSize="10" Text="{Binding SourceLabel}" TextColor="#aaa" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>

                        <!-- Amount + time -->
                        <VerticalStackLayout Grid.Column="2" Spacing="3" HorizontalOptions="End" VerticalOptions="Center">
                            <Label
                                FontAttributes="Bold"
                                FontSize="13"
                                HorizontalOptions="End"
                                Text="{Binding AmountFormatted}"
                                TextColor="{Binding AmountColor}" />
                            <Label FontSize="10" Text="{Binding TimeLabel}" TextColor="#aaa" HorizontalOptions="End" />
                        </VerticalStackLayout>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <!-- Empty state -->
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Fill" Spacing="12" Padding="40">
                    <Image HeightRequest="64" WidthRequest="64" HorizontalOptions="Center" Opacity="0.4">
                        <Image.Source>
                            <FontImageSource FontFamily="MaterialIcons" Glyph="&#xe876;" Color="#aaa" Size="64" />
                        </Image.Source>
                    </Image>
                    <Label Text="No expenses found" FontSize="15" FontAttributes="Bold" TextColor="#aaa" HorizontalOptions="Center" />
                    <Label Text="Try a different filter or add a new expense" FontSize="12" TextColor="#bbb" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
        </CollectionView>
        <Border Grid.Row="4"
                Margin="0,5"
                Padding="16"
                VerticalOptions="End"
                BackgroundColor="#F8F8FC"
                StrokeShape="RoundRectangle 12"
                StrokeThickness="0">
            <Grid ColumnDefinitions="*,*,*">
                <VerticalStackLayout Grid.Column="0" Spacing="4">
                    <Label FontSize="10" Text="Total spent" TextColor="#888" />
                    <Label FontAttributes="Bold" FontSize="15" Text="{Binding MonthTotal, StringFormat='{0:C}'}" TextColor="#E24B4A" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="4" HorizontalOptions="Center">
                    <Label FontSize="10" Text="Transactions" TextColor="#888" />
                    <Label FontAttributes="Bold" FontSize="15" Text="{Binding TransactionCount}" TextColor="#1a1a2e" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="2" Spacing="4" HorizontalOptions="End">
                    <Label FontSize="10" Text="Avg per day" TextColor="#888" />
                    <Label FontAttributes="Bold" FontSize="15" Text="{Binding AvgPerDay, StringFormat='{0:C}'}" TextColor="#1a1a2e" />
                </VerticalStackLayout>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
